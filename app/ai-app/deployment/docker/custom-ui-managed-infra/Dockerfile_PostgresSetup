# deployment/docker/all_in_one/Dockerfile_PostgresSetup

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash appuser

WORKDIR /app

# Minimal deps for the deploy script
COPY src/kdcube-ai-app/requirements-dbdeploy.txt .
RUN pip install --no-cache-dir -r requirements-dbdeploy.txt
COPY deployment/docker/local-python-packages /tmp/kdcube-local-python-packages
RUN if [ -f /tmp/kdcube-local-python-packages/requirements.txt ]; then \
      pip install --no-cache-dir --no-deps --force-reinstall \
        -r /tmp/kdcube-local-python-packages/requirements.txt; \
    fi

# Copy sources (run from source, not as a package)
COPY --chown=appuser:appuser src/kdcube-ai-app/ .

# Run as non-root
USER appuser

CMD ["python", "kdcube_ai_app/ops/deployment/sql/deploy_project.py"]
