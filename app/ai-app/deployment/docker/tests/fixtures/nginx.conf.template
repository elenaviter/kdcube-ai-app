events {
    worker_connections 16;
}

http {
    map $http_x_forwarded_proto $forwarded_proto_last {
        default                        $http_x_forwarded_proto;
        "~,\s*(?<last>[A-Za-z]+)\s*$"  $last;
    }

    map $forwarded_proto_last $forwarded_proto {
        default $scheme;
        http    http;
        https   https;
    }

    server {
        listen 80;
        server_name ${APP_DOMAIN};
        set_real_ip_from ${ALB_CIDR};

        location = / {
            return 302 ${ROUTE_PREFIX}/;
        }

        location = /forwarded-proto {
            default_type text/plain;
            return 200 "$forwarded_proto\n";
        }
    }
}
