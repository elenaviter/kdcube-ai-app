FROM openresty/openresty:alpine

RUN apk add --no-cache gettext

ARG KDCUBE_AI_APP_SOURCE_PATH=.
COPY ${KDCUBE_AI_APP_SOURCE_PATH}/deployment/docker/all_in_one_kdcube/nginx/kdcube-nginx-config \
    /usr/local/bin/kdcube-nginx-config
RUN chmod 0755 /usr/local/bin/kdcube-nginx-config

# EXPOSE 80 443
EXPOSE 80

# Two deployment modes — no config is baked into this image:
#
#   Local install (docker-compose):
#     Host file is bind-mounted directly to /usr/local/openresty/nginx/conf/nginx.conf.
#     OpenResty uses it as-is; the envsubst block below is skipped.
#
#   ECS/Fargate:
#     EFS nginx-config access point is mounted at /nginx-config/.
#     nginx.conf.template and its SHA-256 marker are activated there by the
#     nginx-config-init one-shot task. Startup verifies the template, renders
#     deployment values, validates the candidate, and records the loaded hash.
CMD ["/bin/sh", "-c", \
  "/usr/local/bin/kdcube-nginx-config render \
   && exec openresty -g 'daemon off;'"]
