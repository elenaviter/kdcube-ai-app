# Query and optional connected-account selector.
KDCUBE_DOCS_QUERY=26_006
KDCUBE_DOCS_ACCOUNT_ID=google_<connected-account-id>
KDCUBE_DOCS_LIMIT=20

# Stage 1: the same governed named-services MCP path an external agent uses.
# A URL can be supplied directly, or derived from base URL + tenant + project.
KDCUBE_MCP_URL=
KDCUBE_MCP_BEARER=
KDCUBE_BASE_URL=https://your-kdcube.example
KDCUBE_TENANT=demo-tenant
KDCUBE_PROJECT=demo-project

# Stage 2: optional direct SDK/provider diagnostic. Use a short-lived test
# access token for the SAME Google account. The script never prints it.
GOOGLE_ACCESS_TOKEN=
