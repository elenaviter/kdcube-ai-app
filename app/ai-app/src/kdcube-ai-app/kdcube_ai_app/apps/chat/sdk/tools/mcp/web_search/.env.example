# Web search MCP server — see TOOLS.md for the full reference

# Search provider (Brave is the default backend)
BRAVE_API_KEY=

# Model service (needed only for use_llm=true calls; with use_llm=false
# the pipeline runs without LLM steps and no model keys are required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Default model id. Model ids and their prices live in the deployment's
# price table (economics.yaml); claude-haiku-4-5-20251001 is the id
# there. The three neural roles below are pinned explicitly with
# provider+model, which is what the router uses - keep them pinned.
DEFAULT_LLM_MODEL_ID=claude-haiku-4-5-20251001
# The three neural roles of the pipeline. See TOOLS.md, "The neural
# pipeline". Haiku is the intended class for these roles: fast, cheap,
# and strong enough for scoring, filtering, and span extraction.
ROLE_MODELS_JSON={"tool.source.reconciler":{"provider":"anthropic","model":"claude-haiku-4-5-20251001"},"tool.sources.filter.by.content":{"provider":"anthropic","model":"claude-haiku-4-5-20251001"},"tool.sources.filter.by.content.and.segment":{"provider":"anthropic","model":"claude-haiku-4-5-20251001"}}

# Alternative to individual keys: point at a KDCube deployment's config
# and keys resolve from there (services.brave.api_key, model keys).
# ASSEMBLY_YAML_DESCRIPTOR_PATH=/path/to/assembly.yaml
# GLOBAL_SECRETS_YAML=/path/to/secrets.yaml

# Egress filter (operator-owned). Deny wins: a blocklisted host is
# refused even when the allowlist admits it.
# Files: one entry per line, '#' comments; re-read when the file changes.
# Entry format: example.org (domain + subdomains), *.example.org (subdomains only)
# Allowlist (unset = every host allowed):
WEB_ALLOWLIST_FILE=
# Or inline, comma-separated (fixed for the process):
WEB_ALLOWLIST=
# Blocklist (unset = no host blocked):
WEB_BLOCKLIST_FILE=
WEB_BLOCKLIST=

# Cache
REDIS_URL=
TENANT_ID=
DEFAULT_PROJECT_NAME=
WEB_SEARCH_CACHE_TTL_SECONDS=3600

# MCP server binding (only for http/sse modes)
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8787
